# ==========================================
# TaskFlow Backend Environment Configuration
# Project: Dainik Jagran Workflow & Task Management
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database (MongoDB connection string)
MONGO_URI=mongodb://127.0.0.1:27017/taskflow

# Authentication & Security
JWT_SECRET=replace_with_a_long_random_secret_taskflow_secure_key

# Client URLs & CORS Origins
CLIENT_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000
VITE_API_URL=http://localhost:5000/api

# Cloudinary Integration (Media Storage & Attachments)
# Used for storing story attachments, news assets, documentation, and user media on Cloudinary CDN
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Optional Services
# Resend Email Service
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# Google OAuth Integration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email Validation API
ABSTRACT_EMAIL_API_KEY=
